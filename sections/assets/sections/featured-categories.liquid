<section class="featured-categories">
  <div class="page-width">

    <div class="featured-categories__header">
      {% if section.settings.eyebrow != blank %}
        <p class="featured-categories__eyebrow">
          {{ section.settings.eyebrow }}
        </p>
      {% endif %}

      <h2>{{ section.settings.heading }}</h2>

      {% if section.settings.description != blank %}
        <div class="featured-categories__description">
          {{ section.settings.description }}
        </div>
      {% endif %}
    </div>

    <div class="featured-categories__grid">

      {% for block in section.blocks %}
        {% if block.settings.collection != blank %}

          <a
            href="{{ block.settings.collection.url }}"
            class="category-card"
            {{ block.shopify_attributes }}
          >

            <div class="category-card__image">

              {% if block.settings.image != blank %}
                {{
                  block.settings.image
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    widths: '360, 540, 720, 900',
                    sizes: '(min-width: 990px) 33vw, 100vw',
                    alt: block.settings.image.alt
                }}

              {% elsif block.settings.collection.featured_image %}
                {{
                  block.settings.collection.featured_image
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    widths: '360, 540, 720, 900',
                    sizes: '(min-width: 990px) 33vw, 100vw',
                    alt: block.settings.collection.title
                }}
              {% endif %}

            </div>

            <div class="category-card__content">
              <h3>{{ block.settings.collection.title }}</h3>
              <span>Shop collection</span>
            </div>

          </a>

        {% endif %}
      {% endfor %}

    </div>

  </div>
</section>

{% schema %}
{
  "name": "Featured Categories",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Shop by category"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Explore our collections"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Help customers discover the right products with clear collection-based navigation.</p>"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Categories",
      "blocks": [
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        }
      ]
    }
  ]
}
{% endschema %}

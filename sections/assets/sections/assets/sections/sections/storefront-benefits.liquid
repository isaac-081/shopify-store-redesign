<section class="storefront-benefits">
  <div class="page-width">

    <div class="storefront-benefits__grid">

      {% for block in section.blocks %}
        <div class="storefront-benefit" {{ block.shopify_attributes }}>

          {% if block.settings.icon != blank %}
            <div class="storefront-benefit__icon">
              {{ block.settings.icon }}
            </div>
          {% endif %}

          {% if block.settings.heading != blank %}
            <h3>{{ block.settings.heading }}</h3>
          {% endif %}

          {% if block.settings.description != blank %}
            <p>{{ block.settings.description }}</p>
          {% endif %}

        </div>
      {% endfor %}

    </div>

  </div>
</section>

{% schema %}
{
  "name": "Storefront Benefits",
  "settings": [],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon",
          "default": "✓"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Free Shipping"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Enjoy free shipping on qualifying orders."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Storefront Benefits",
      "blocks": [
        {
          "type": "benefit"
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "🔒",
            "heading": "Secure Checkout",
            "description": "Your payment information is protected."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "↩",
            "heading": "Easy Returns",
            "description": "Simple and convenient returns when needed."
          }
        }
      ]
    }
  ]
}
{% endschema %}
